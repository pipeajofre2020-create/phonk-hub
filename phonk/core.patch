+/*
+ * Phonk Hub — personal build of SimpMusic (GPL-3.0)
+ */
+
+package com.maxrave.common
+
+/**
+ * Phonk Hub's identity. `phonk/aplicar_marca.py` rewrites NAME from `marca/nombre.txt` and REPO from
+ * the GitHub repository that runs the build, so these values are only the defaults.
+ */
+object PhonkBrand {
+    /** The app's name, as shown in the window title, the Music folder and notifications. */
+    const val NAME = "Phonk Hub"
+
+    /** "owner/repository" on GitHub whose releases carry new versions. Empty: no update check. */
+    const val REPO = ""
+
+    /** Page where a new version can be downloaded. */
+    val RELEASES_PAGE: String
+        get() = if (REPO.isBlank()) "https://github.com" else "https://github.com/$REPO/releases/latest"
+}
