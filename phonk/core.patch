+/**
+ * Phonk Hub: "Artist - Title [videoId]", so the files read well in the Music folder and other players,
+ * while every lookup still finds them by the id inside the brackets.
+ */
+internal fun downloadFileBase(
+    title: String,
+    artists: List<String>?,
+    videoId: String,
+): String {
+    val artist = artists?.filter { it.isNotBlank() }?.joinToString(", ").orEmpty()
+    val label = if (artist.isBlank()) title else "$artist - $title"
+    val safe =
+        label
+            .replace(Regex("[\\\\/:*?\"<>|\\p{Cntrl}]"), " ")
+            .replace(Regex("\\s+"), " ")
+            .trim()
+            .trimEnd('.')
+            .take(120)
+            .trim()
+    return if (safe.isEmpty()) videoId else "$safe [$videoId]"
+}
+
+/** The video id a download was saved under, or null for a file this app did not write. */
+internal fun downloadedVideoIdOf(fileName: String): String? {
+    val base = fileName.substringBeforeLast('.')
+    Regex("\\[([^\\[\\]]+)]$").find(base)?.let { return it.groupValues[1].removePrefix(MERGING_DATA_TYPE.VIDEO) }
+    // Files written before Phonk Hub named them: the bare id.
+    return base.removePrefix(MERGING_DATA_TYPE.VIDEO).takeIf { Regex("[A-Za-z0-9_-]{11}").matches(it) }
+}
+
+// Phonk Hub: downloads live in the user's Music folder, under the app's name.
+fun getDownloadPath(): String = System.getProperty("user.home") + File.separator + "Music" + File.separator + PhonkBrand.NAME
