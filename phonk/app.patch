@@ -0,0 +1,72 @@
+/*
+ * Phonk Hub — personal build of SimpMusic (GPL-3.0)
+ */
+
+package com.maxrave.simpmusic.ui.theme
+
+import androidx.compose.material3.ColorScheme
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.lerp
+import androidx.compose.ui.graphics.luminance
+
+/**
+ * Phonk Hub's fixed palette: black background, orange for everything you can tap, white text.
+ * The accent follows the theme colour setting, so choosing a custom colour in Settings replaces
+ * the orange and keeps the black and white.
+ */
+object PhonkPalette {
+    val Accent = Color(0xFFFF9900)
+    val DarkBackground = Color(0xFF000000)
+    val DarkText = Color(0xFFFFFFFF)
+    val LightBackground = Color(0xFFFFFFFF)
+    val LightText = Color(0xFF000000)
+}
+
+/**
+ * Rewrites [base] so that every role maps onto three colours. Surfaces step from [background]
+ * towards [text], so raised panels stay distinguishable without introducing new hues.
+ */
+fun phonkColorScheme(
+    base: ColorScheme,
+    accent: Color,
+    background: Color,
+    text: Color,
+): ColorScheme {
+    fun towardsText(fraction: Float) = lerp(background, text, fraction)
+
+    fun towardsAccent(fraction: Float) = lerp(background, accent, fraction)
+    val onAccent = if (accent.luminance() > 0.4f) Color.Black else Color.White
+    return base.copy(
+        primary = accent,
+        onPrimary = onAccent,
+        primaryContainer = towardsAccent(0.35f),
+        onPrimaryContainer = text,
+        inversePrimary = accent,
+        secondary = accent,
+        onSecondary = onAccent,
+        secondaryContainer = towardsAccent(0.25f),
+        onSecondaryContainer = text,
+        tertiary = accent,
+        onTertiary = onAccent,
+        tertiaryContainer = towardsAccent(0.25f),
+        onTertiaryContainer = text,
+        background = background,
+        onBackground = text,
+        surface = background,
+        onSurface = text,
+        surfaceVariant = towardsText(0.12f),
+        onSurfaceVariant = towardsText(0.72f),
+        surfaceTint = accent,
+        surfaceBright = towardsText(0.16f),
+        surfaceDim = background,
+        surfaceContainerLowest = background,
+        surfaceContainerLow = towardsText(0.04f),
+        surfaceContainer = towardsText(0.07f),
+        surfaceContainerHigh = towardsText(0.10f),
+        surfaceContainerHighest = towardsText(0.14f),
+        outline = towardsText(0.38f),
+        outlineVariant = towardsText(0.16f),
+        inverseSurface = text,
+        inverseOnSurface = background,
+    )
+}
