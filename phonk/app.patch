--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/maxrave/simpmusic/phonk/PhonkFeatures.kt
@@ -0,0 +1,31 @@
+/*
+ * Phonk Hub — personal build of SimpMusic (GPL-3.0)
+ */
+
+package com.maxrave.simpmusic.phonk
+
+/**
+ * Switches for SimpMusic features that Phonk Hub hides. Set one to true to bring it back.
+ */
+object PhonkFeatures {
+    /** Analytics tab and listening statistics. */
+    const val STATS = false
+
+    /** Year-in-review reel and monthly recaps. */
+    const val WRAPPED = false
+
+    /** Song recognition with the microphone (Android). */
+    const val RECOGNITION = false
+
+    /** AI provider settings and the AI reading of your taste. */
+    const val AI = false
+
+    /** SimpMusic's own review requests, blog promos and launch banners. */
+    const val PROMOS = false
+
+    /** SimpMusic's check that blocks copies not signed with its release key. */
+    const val SIMPMUSIC_SIGNATURE_CHECK = false
+
+    /** Start on the Downloads list instead of Home. */
+    const val OPEN_ON_DOWNLOADS = true
+}
